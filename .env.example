# Copy to .env.local (git-ignored) and fill in. Never commit real values.

# Supabase (from M2). Public values; safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never import in client code, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Show official member photos (copyrighted). Off unless set to "true".
NEXT_PUBLIC_SHOW_MEMBER_PHOTOS=false
