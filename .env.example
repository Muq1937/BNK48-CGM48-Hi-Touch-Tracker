# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# On Vercel these are set by the Supabase integration; `vercel env pull` copies them here.

# Supabase public settings. Safe in the browser (RLS protects the data).
# SUPABASE_URL / SUPABASE_PUBLISHABLE_KEY also work (see next.config.ts).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only, bypasses RLS. Never import in client code, never commit. (Not used yet.)
SUPABASE_SECRET_KEY=

# Show "Continue with email". Off unless set to "true"; needs custom SMTP in Supabase first.
NEXT_PUBLIC_EMAIL_SIGN_IN=false

# Show official member photos (copyrighted). Off unless set to "true".
NEXT_PUBLIC_SHOW_MEMBER_PHOTOS=false
